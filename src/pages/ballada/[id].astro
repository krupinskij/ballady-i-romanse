---
import { BalladSchema } from '@model';
import Layout from '@layouts/Layout.astro';
import Motto from '@components/Motto.astro';
import Note from '@components/Note.astro';
import Content from '@components/Content.astro';
import { GET } from '../api/ballads/[id].json';
import AnnotationMarker from '@components/AnnotationMarker.astro';
import { formatText } from '@utils';
import AnnotationNote from '@components/AnnotationNote.astro';
import i18next from 'i18next';
import i18n from '@i18n';

const response = await GET(Astro);
if (response.status >= 300 && response.status <= 400) {
  return Astro.redirect(response.headers.get('Location', response.status));
}

const ballad = BalladSchema.parse(await response.json());
const { title, link, prevBallad, nextBallad, notes, mottos, contents, annotations } = ballad;
---

<Layout title={`${formatText(title, (_, __, title) => title)} | ${i18next.t('title')}`}>
  <header>
    <h1><AnnotationMarker body={title} /></h1>
  </header>
  {notes && notes.map(({ body }) => <Note body={body} />)}
  <article>
    {mottos.map((motto) => <Motto {...motto} />)}
    {contents.map((content) => <Content {...content} />)}
  </article>
  {
    annotations.length > 0 && (
      <article>
        <section class="annotations">
          {annotations.map((annotation) => (
            <AnnotationNote {...annotation}>{annotation.body}</AnnotationNote>
          ))}
        </section>
      </article>
    )
  }

  {
    prevBallad && (
      <a class="link" href={`/ballada/${prevBallad.id}`} data-order="prev">
        ⬅ {formatText(prevBallad.title, (_, __, title) => title)}
      </a>
    )
  }
  {
    nextBallad && (
      <a class="link" href={`/ballada/${nextBallad.id}`} data-order="next">
        {formatText(nextBallad.title, (_, __, title) => title)} ➡
      </a>
    )
  }
  <Fragment slot="footer">
    <div class="footer">
      {i18n.t('footer', { ns: 'ballad' })}
      <a target="_blank" href={link}>{link}</a>
    </div>
  </Fragment>
</Layout>

<style lang="scss">
  h1 {
    font: var(--font-xxxl);
    font-family: var(--font-cursive);
    text-align: center;
  }

  article {
    width: max-content;
    max-width: 90vw;
    margin-inline: auto;
  }

  .annotations {
    margin-top: 60px;
    counter-reset: annotationNote;
  }

  a.link {
    margin: var(--spacing-4);
    font: var(--font-md);
    position: fixed;
    top: var(--header-height);

    &:hover {
      text-decoration: underline;
    }

    &[data-order='prev'] {
      left: 0;
    }
    &[data-order='next'] {
      right: 0;
    }
  }

  .footer {
    text-align: center;
    font: var(--font-xs);
    padding: 20px 120px;

    a {
      text-decoration: underline;
      text-wrap: wrap;
    }
  }
</style>
