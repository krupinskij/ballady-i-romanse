---
import Card from '@components/Card.astro';
import Layout from '@layouts/Layout.astro';

import { GET } from '../api/ballads/list.json';
import i18n from '@i18n';
import { z } from 'astro/zod';
import { ListSchema } from '@model';

const device = Astro.locals.DEVICE;
const lang = Astro.currentLocale;
const response = await GET(Astro);
const ballads = z.array(ListSchema).parse(await response.json());
---

<Layout title={`${i18n.t('title')} | ${i18n.t('author')}`}>
  {
    device === 'desktop' && (
      <header>
        <img src="/images/top.webp" alt="" role="presentation" data-position="top" />
        <img src="/images/bottom.webp" alt="" role="presentation" data-position="bottom" />
        <img src="/images/left.webp" alt="" role="presentation" data-position="left" />
        <img src="/images/right.webp" alt="" role="presentation" data-position="right" />
        <h1 data-author={i18n.t('author')}>{i18n.t('title')}</h1>
      </header>
    )
  }
  <article>
    <ul data-device={device}>
      {
        ballads.map((ballad) => (
          <li>
            <Card title={ballad.title} href={`/ballada/${ballad.id}`} />
          </li>
        ))
      }
    </ul>
  </article>
  <Fragment slot="footer">
    {i18n.t('footer', { ns: 'home' })}
  </Fragment>
</Layout>

<style lang="scss">
  header {
    position: relative;
    width: 100%;
    height: 460px;
    margin-inline: auto;
    margin-bottom: var(--spacing-6);
    max-width: 1080px;

    img {
      position: absolute;
    }

    img[data-position='top'] {
      top: 0;
      left: 50%;
      translate: -50% 0;
      transform-origin: 50% 0;
      z-index: 1;
    }

    img[data-position='bottom'] {
      bottom: 0;
      left: 50%;
      translate: -50% 0;
      transform-origin: 50% 100%;
      z-index: 1;
    }

    img[data-position='left'] {
      left: 0;
      transform-origin: 0 0;
      z-index: 0;
    }

    img[data-position='right'] {
      right: 0;
      transform-origin: 100% 0;
      z-index: 0;
    }
  }

  h1,
  h2 {
    position: relative;
    translate: 0 -50%;

    text-align: center;
  }

  h1 {
    font: var(--font-xxxl);
    font-family: var(--font-cursive);
    margin-inline: 120px;
    top: 50%;

    &::after {
      content: attr(data-author);
      display: block;
      position: absolute;
      font: var(--font-xxl);
      font-family: var(--font-cursive);
      left: 0;
      right: 0;
    }
  }

  ul {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-2);
    max-width: max(1400px, 100dvw);
    margin-inline: calc(-1 * var(--main-padding));
    padding: var(--spacing-4);
    background-color: var(--color-bg-secondary);
    box-shadow: inset 0px -4px 4px var(--color-shadow);
  }

  ul[data-device='desktop'] {
    gap: var(--spacing-6);
    padding: var(--spacing-6);
    box-shadow:
      inset 0px 4px 4px var(--color-shadow),
      inset 0px -4px 4px var(--color-shadow);
  }
</style>
