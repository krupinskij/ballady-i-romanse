---
import { BalladSchema } from '@model';
import Layout from '@layouts/Layout.astro';
import Motto from '@components/Motto.astro';
import Note from '@components/Note.astro';
import Content from '@components/Content.astro';
import { GET } from '../api/ballads/[id].json';
import AnnotationMarker from '@components/AnnotationMarker.astro';
import { formatText } from '@utils';
import AnnotationNote from '@components/AnnotationNote.astro';
import i18next from 'i18next';
import i18n from '@i18n';

const response = await GET(Astro);
if (response.status >= 300 && response.status <= 400) {
  return Astro.redirect(response.headers.get('Location', response.status));
}

const ballad = BalladSchema.parse(await response.json());
const { title, link, prevBallad, nextBallad, notes, mottos, contents, annotations } = ballad;
---

<Layout title={`${formatText(title, (_, __, title) => title)} | ${i18next.t('title')}`}>
  <Fragment slot="header">
    <nav>
      <span>
        {
          prevBallad && (
            <a href={`/ballad/${prevBallad.id}`} style={{ textAlign: 'left' }}>
              ⬅<span> {formatText(prevBallad.title, (_, __, title) => title)}</span>
            </a>
          )
        }
      </span>
      <a href="/" style={{ textAlign: 'center' }}>⌂ <span>{i18n.t('homepage')}</span></a>
      <span>
        {
          nextBallad && (
            <a href={`/ballad/${nextBallad.id}`} style={{ textAlign: 'right' }}>
              <span>{formatText(nextBallad.title, (_, __, title) => title)} </span>➡
            </a>
          )
        }
      </span>
    </nav>
    <h1><AnnotationMarker body={title} /></h1>
    {notes && notes.map(({ body }) => <Note body={body} />)}
  </Fragment>
  <main>
    <article>
      {mottos.map((motto) => <Motto {...motto} />)}
      {contents.map((content) => <Content {...content} />)}
    </article>
    {
      annotations.length > 0 && (
        <article>
          <section class="annotations">
            {annotations.map((annotation) => (
              <AnnotationNote {...annotation}>{annotation.body}</AnnotationNote>
            ))}
          </section>
        </article>
      )
    }
  </main>
  <Fragment slot="footer">
    <div class="footer">
      {i18n.t('footer', { ns: 'ballad' })}
      <a target="_blank" href={link}>{link}</a>
    </div>
  </Fragment>
</Layout>

<style lang="scss">
  main {
    margin-bottom: 48px;
    overflow: hidden;
  }

  header {
    margin-bottom: 32px;
  }

  h1 {
    font: var(--font-xxl);
    font-family: var(--font-cursive);
    text-align: center;
  }

  h2 {
    font-weight: 500;
  }

  nav {
    position: fixed;
    inset: 0 0 auto 0;
    padding: 8px 16px;

    background-color: var(--bg-color-default);

    display: grid;
    grid-template-columns: 1fr 1fr 1fr;

    & a {
      display: inline-block;
      width: 100%;

      font: var(--font-md);
      text-wrap: nowrap;

      &:hover {
        text-decoration: underline;
      }

      & > span {
        display: none;
        @media (min-width: 640px) {
          display: inline;
        }
      }
    }
  }

  article {
    width: max-content;
    max-width: 90vw;
    margin-inline: auto;
  }

  .annotations {
    margin-top: 60px;
    counter-reset: annotationNote;
  }

  .footer {
    text-align: center;
    font: var(--font-xs);
    padding: 20px 120px;

    a {
      text-decoration: underline;
      text-wrap: wrap;
    }
  }
</style>
