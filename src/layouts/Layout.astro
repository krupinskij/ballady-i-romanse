---
import '@styles/reset.css';
import '@styles/base.css';
import i18n from '@i18n';
import LanguageSelect from '@components/LanguageSelect.astro';
import { ClientRouter } from 'astro:transitions';
import Header from './Header';
import { NavigationDrawer, SettingsDrawer } from '@components/Drawer';
import FontSizeSelect from '@components/FontSizeSelect.astro';
import { getFontSize } from 'src/font';

interface Props {
  title: string;
}

const { title } = Astro.props;
const device = Astro.locals.DEVICE;

const fontSize = getFontSize(Astro.cookies.get('font-size')?.value);
---

<!doctype html>
<html lang={i18n.language} data-device={device}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={`${i18n.t('title')} - ${i18n.t('author')}`} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/icon.ico" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <ClientRouter />
  </head>
  <body>
    <Header />
    <SettingsDrawer />
    <NavigationDrawer />
    <main data-device={device}>
      <slot />
    </main>
    <footer>
      <slot name="footer" />
      {
        device === 'desktop' && (
          <div>
            <FontSizeSelect />
            <LanguageSelect />
          </div>
        )
      }
    </footer>
  </body>
</html>

<style define:vars={{ fontSize }}>
  :root {
    font-size: var(--fontSize);
  }

  body {
    --header-height: 60px;
    --content-width: 80ch;

    overflow-x: hidden;
  }

  main {
    --main-padding: var(--spacing-2);

    margin-top: var(--header-height);
    padding: 0 var(--main-padding);
    position: relative;
    z-index: 0;
  }

  main[data-device='desktop'] {
    --main-padding: var(--spacing-6);

    padding: var(--main-padding);
  }

  footer {
    margin-top: var(--spacing-4);
    text-align: center;
    font: var(--font-xs);
    padding: var(--spacing-4);
  }
</style>
