---
import i18n from '@i18n';
import hamburgerSVG from '/icons/hamburger.svg?raw';
import settingsSVG from '/icons/settings.svg?raw';

const device = Astro.locals.DEVICE;
const lng = Astro.currentLocale;
---

<header data-device={device}>
  {
    device === 'desktop' && (
      <a id="skip" href="#main">
        {i18n.t('skipNavigation')}
      </a>
    )
  }
  <a id="title" href=`/${lng}/`>{i18n.t('title')}</a>
  <div class="controls">
    <button id="settings-toggle" class="toggle" aria-controls="navigation" aria-expanded="false">
      <span class="visually-hidden">{i18n.t('settings.label', { ns: 'drawer' })}</span>
      <Fragment set:html={settingsSVG} />
    </button>
    <button id="navigation-toggle" class="toggle" aria-controls="settings" aria-expanded="false">
      <span class="visually-hidden">{i18n.t('navigation.label', { ns: 'drawer' })}</span>
      <Fragment set:html={hamburgerSVG} />
    </button>
  </div>
</header>

<style lang="scss">
  header {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--header-height);
    width: 100%;
    background-color: var(--color-bg-primary);
    box-shadow: 0px 4px 4px var(--color-shadow);
    font: var(--font-xl);
    font-family: var(--font-cursive);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--spacing-4);
    text-wrap: nowrap;
    z-index: 3;
  }

  header[data-device='desktop'] {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    justify-items: center;
  }

  #title {
    padding-top: var(--spacing-2);
  }

  #skip {
    font: var(--font-md);
    font-family: var(--font-default);
    justify-self: start;
    transform: translateY(-100px);
  }

  #skip:focus {
    transform: translateY(0);
  }

  .controls {
    display: flex;
    gap: var(--spacing-1);
    justify-self: end;
  }

  .toggle {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: var(--spacing-1);
    background-color: var(--color-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--spacing-1);
    cursor: pointer;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const navigationToggle = document.getElementById('navigation-toggle');
    const navigationDrawer = document.getElementById('navigation-drawer');

    const settingsToggle = document.getElementById('settings-toggle');
    const settingsDrawer = document.getElementById('settings-drawer');

    if (!navigationToggle || !navigationDrawer || !settingsToggle || !settingsDrawer) return;

    const controlsMap = new WeakMap<HTMLElement, HTMLElement>();
    controlsMap.set(navigationToggle, navigationDrawer);
    controlsMap.set(settingsToggle, settingsDrawer);

    const drawers = [navigationDrawer, settingsDrawer];
    const toggles = [navigationToggle, settingsToggle];

    const handleClick = (event: MouseEvent) => {
      const toggle = event.currentTarget as HTMLElement;
      const drawer = controlsMap.get(toggle);

      if (!toggle || !drawer) return;

      const state = drawer.dataset.state;

      if (state === 'opened') {
        drawer.dataset.state = 'closed';
        toggle.ariaExpanded = 'false';
      } else {
        drawers.forEach((drawer) => (drawer.dataset.state = 'closed'));
        toggles.forEach((toggle) => (toggle.ariaExpanded = 'false'));
        drawer.dataset.state = 'opened';
        toggle.ariaExpanded = 'true';
      }
    };

    navigationToggle.addEventListener('click', handleClick);
    settingsToggle.addEventListener('click', handleClick);
  });
</script>
