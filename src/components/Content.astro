---
import { type Content } from '@model';
import AnnotationMarker from './AnnotationMarker.astro';

type Props = Content;

const { speaker, body } = Astro.props;
---

<section>
  {speaker && <h2>{speaker}:</h2>}

  <p><AnnotationMarker body={body} /></p>
</section>

<style>
  section {
    margin-bottom: var(--spacing-6);
  }

  h2 {
    font: var(--font-md);
  }

  p {
    white-space: pre-line;
    font: var(--font-md);
    font-family: var(--font-default);
    text-wrap: wrap;
  }
</style>
