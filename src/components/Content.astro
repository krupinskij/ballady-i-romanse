---
import { type Content } from '@model';
import AnnotationMarker from './AnnotationMarker.astro';

type Props = Content;

const { speaker, body } = Astro.props;
---

<section>
  {speaker && <h2>{speaker}:</h2>}

  <pre><AnnotationMarker body={body} /></pre>
</section>

<style>
  section {
    margin-bottom: 32px;
  }

  h2 {
    font: var(--font-md);
  }

  pre {
    font: var(--font-md);
    font-family: var(--font-default);
    text-wrap: wrap;
  }
</style>
