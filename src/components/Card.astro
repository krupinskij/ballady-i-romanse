---
import AnnotationMarker from './AnnotationMarker.astro';

interface Props {
  title: string;
  href: string;
}

const { title, href } = Astro.props;
const device = Astro.locals.DEVICE;
---

<a href={href} data-device={device}>
  <div><AnnotationMarker body={title} noAnchor /></div>
</a>

<style lang="scss">
  a {
    border: 3px double var(--color-border);
    background-color: var(--color-bg-primary);
    width: 160px;
    aspect-ratio: 2/1;

    display: flex;
    justify-content: center;
    align-items: center;

    &:hover {
      text-decoration: underline;
    }

    & > div {
      font: var(--font-lg);
      text-align: center;
    }
  }

  a[data-device='desktop'] {
    width: 256px;
  }
</style>
