---
import { formatText } from '@utils';

type Props = {
  body: string;
  noAnchor?: boolean;
};

const { body, noAnchor } = Astro.props;

const formattedText = formatText(
  body,
  (_, key, text) =>
    `<span id="cite_ref-${key}" class="${noAnchor ? '' : '@anno_text'}">${text}${
      noAnchor ? '' : `<a class="@anno_ref" href="#cite_note-${key}"></a>`
    }</span>`
);
---

<Fragment set:html={formattedText} />
