---
import i18n, { supportedLngs } from '@i18n';

const currentLng = Astro.currentLocale;
const pathname = Astro.url.pathname;
const pathnameRegexp = /^\/([a-z]*)\/*/;
---

<div data-component="language-select">
  {
    supportedLngs.map((lng) => (
      <a
        aria-label={i18n.t(`language.${lng}`)}
        data-value={lng}
        aria-selected={lng === currentLng}
        role="option"
        href={pathname.replace(pathnameRegexp, `/${lng}/`)}
        hreflang={lng}
      >
        <img src={`/${lng}.svg`} alt="" height="24" />
      </a>
    ))
  }
</div>

<style>
  div {
    width: max-content;
    display: flex;
    gap: var(--spacing-2);
  }

  a {
    cursor: pointer;
    border: 1px solid var(--color-border);
    filter: grayscale(0.8);
  }

  a[aria-selected='true'] {
    filter: none;
    pointer-events: none;
  }

  img {
    display: block;
  }
</style>
