---
import { type Motto } from '@model';
import AnnotationMarker from './AnnotationMarker.astro';

type Props = Motto;

const { body, author, translation } = Astro.props;
---

<section>
  <pre><AnnotationMarker body={body} /></pre>
  <pre class="author"><AnnotationMarker body={author} /></pre>
  {
    translation && (
      <pre>
        <AnnotationMarker body={translation} />
      </pre>
    )
  }
</section>

<style lang="scss">
  section {
    margin-bottom: var(--spacing-4);
  }

  pre {
    font: var(--font-sm);
    text-align: right;

    &.author:has(+ *) {
      margin-bottom: var(--spacing-2);
    }
  }
</style>
